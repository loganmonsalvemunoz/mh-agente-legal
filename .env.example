# Copia este archivo a .env y completa los valores. Nunca subas .env a git.

PORT=3100

# Apaga el panel admin (y la conexion de WhatsApp) sin tocar el widget web. Poner en
# "true" o borrar la linea para reactivarlo. El widget funciona igual con esto en false.
ADMIN_ENABLED=true

# Apaga el canal de pedidos por WhatsApp — deja solo el widget web activo. Poner en
# "true" o borrar la linea para reactivarlo.
WHATSAPP_ENABLED=true

# Dejar vacío/"development" en local. En el VPS de producción: "production".
NODE_ENV=

# Sesion del panel admin — genera un valor aleatorio largo, p. ej. con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Credenciales del panel admin
ADMIN_USER=admin
# Genera el hash con: npm run hash-password -- "tu-clave-segura"
ADMIN_PASSWORD_HASH=

# Origen permitido para el widget web (CORS). En local usa el archivo de prueba
# (file:// no manda Origin, así que el navegador no aplica CORS ahí); en producción
# pon el dominio real, ej: https://mhgrupoempresarial.com
WIDGET_ALLOWED_ORIGIN=https://mhgrupoempresarial.com

# Nivel de log de Baileys: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=warn
